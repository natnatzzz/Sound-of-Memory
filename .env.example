# Local Postgres development defaults. Copy to .env.local and set your password.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sound_of_memory
PGUSER=memory_app
PGPASSWORD=REPLACE_WITH_YOUR_LOCAL_DATABASE_PASSWORD

# For Cloud SQL through the Auth Proxy, use port 5433,
# database memory-db, and user postgres (or a dedicated application user).
# cloud-sql-proxy --port 5433 sound-of-memory-511302:us-east1:memory-db
# For Cloud Run, set PGHOST=/cloudsql/sound-of-memory-511302:us-east1:memory-db
# and provide PGPASSWORD through Secret Manager.

# Analytics password: server-only scrypt hash, formatted salt:hash.
# Configure in .env.local locally, or as a deployment secret. Never use NEXT_PUBLIC_.
ANALYSIS_PASSWORD_HASH=
